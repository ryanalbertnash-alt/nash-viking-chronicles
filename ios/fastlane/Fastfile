default_platform(:ios)

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
    )
    team = ENV.fetch("APPLE_TEAM_ID")
    bundle_id = File.read("../src/shared/app.ts")[/BUNDLE_ID = "([^"]+)"/, 1]
    UI.user_error!("BUNDLE_ID missing") if bundle_id.to_s.empty?

    if ENV["MATCH_GIT_URL"].to_s != ""
      match(
        type: "appstore",
        api_key: api_key,
        readonly: true,
        git_url: ENV.fetch("MATCH_GIT_URL"),
        app_identifier: bundle_id,
      )
    else
      cert(api_key: api_key, team_id: team)
      sigh(api_key: api_key, app_identifier: bundle_id, team_id: team)
    end

    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
      build_number: Time.now.utc.strftime("%Y%m%d%H%M"),
    )
    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_team_id: team,
      xcargs: "DEVELOPMENT_TEAM=#{team} CODE_SIGN_STYLE=Automatic -allowProvisioningUpdates",
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
