{
  "name": "nash-viking-chronicles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc -b && vite build",
    "test": "tsx tests/world.test.ts && tsx tests/ws.test.ts",
